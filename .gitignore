deploy/config.env
__pycache__/
*.pyc

# 私钥等敏感凭证，禁止提交
secrets/
# 数据库栈运行时环境变量（含密码；旧名 .env.db 与新布局 db/.env 均忽略）
deploy/db/.env.db
deploy/db/.env
deploy/db/docker-compose.yml
# 调试配置与日志（含 session id，不应提交）
.dbg/
# 废弃脚本归档（含旧密钥文件，仅本地留存，不入仓库）
deploy/archive/
# 详细设计和初赛提交文档，提交到仓库
