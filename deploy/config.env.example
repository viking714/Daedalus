# ============================================================================
# Daedalus / AgentTeams 统一部署配置（单一事实来源）
# ----------------------------------------------------------------------------
# 复制为 config.env 后填写真实值：cp deploy/config.env.example deploy/config.env
# config.env 含密钥，已被 .gitignore 忽略，切勿提交。
#
# 架构：所有组件统一运行在「本机」（脚本所在机器）——本机优先模式：
#   - AgentTeams 平台 v1.2.x（agentteams-controller / agentteams-manager / agentteams-worker-*）
#   - 数据库栈（PostgreSQL+pgvector / Redis / Meilisearch / Neo4j，docker compose）
#   - 领域技能 MCP Server（本机进程，端口 ${MCP_PORT}；Worker 容器经
#     ${MCP_WORKER_HOST}:${MCP_PORT} 访问）
#   - （可选）AgentLoop 云可观测
# 脚本直接在目标主机运行（本地笔记本、或先 ssh 登录的服务器均可），
# 无需从另一台机器 SSH 远程操控。
# ============================================================================

# ===== 0. 运行时根目录 =====
# 数据库栈 compose 与生成的运行时 .env 落在此目录（留空默认 deploy/）。
RUNTIME_DIR=

# ===== 1. AgentTeams 平台（官方安装器读取 AGENTTEAMS_* 前缀） =====
# 版本固定为端到端验证过的 v1.2.3（latest 可能引入未验证变更）。
AGENTTEAMS_VERSION=v1.2.3
AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_LANGUAGE=zh

# LLM（OpenAI 兼容后端；默认硅基流动，国内直连）
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Pro
AGENTTEAMS_LLM_API_KEY=
AGENTTEAMS_OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 平台管理员（Matrix admin 登录凭据，runner/脚本均依赖）
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_ADMIN_PASSWORD=

# 端口与域名（保持与既有部署一致，勿随意改动；改动需同步 runner 与 souls）
AGENTTEAMS_PORT_GATEWAY=18080
AGENTTEAMS_PORT_CONSOLE=18001
AGENTTEAMS_PORT_ELEMENT_WEB=18088
# 端口绑定模式：1=仅绑 127.0.0.1（默认，安全；外部访问用 SSH 隧道），
# 0=绑 0.0.0.0（公网直连，需同步在云安全组放行对应端口，修改后需重跑 install.sh）
AGENTTEAMS_LOCAL_ONLY=1
# 浏览器端 Element 连接 Matrix 网关的地址：本地/隧道模式留空（默认 127.0.0.1:网关端口）；
# 公网直连（LOCAL_ONLY=0）时必须设为外部浏览器可达的网关地址，如 http://<EIP>:18080
AGENTTEAMS_ELEMENT_HOMESERVER_URL=
AGENTTEAMS_MATRIX_DOMAIN=matrix-local.hiclaw.io:18080

# 运行时：manager 必须为 qwenpaw（v1.2.3 默认镜像 agentteams-manager-qwenpaw，
# 写 openclaw 会因容器内缺二进制而崩溃重启）；普通 worker 默认 openclaw。
AGENTTEAMS_MANAGER_RUNTIME=qwenpaw
AGENTTEAMS_DEFAULT_WORKER_RUNTIME=openclaw

# 数据目录（留空用安装器默认值）
AGENTTEAMS_DATA_DIR=
AGENTTEAMS_WORKSPACE_DIR=

# MinIO 共享存储由安装器内置管理（worker 经 controller 注入的 agentteams alias 访问），
# 一般无需配置；仅当需要覆盖安装器默认时才填写 AGENTTEAMS_MINIO_*。
AGENTTEAMS_MINIO_ENDPOINT=
AGENTTEAMS_MINIO_USER=
AGENTTEAMS_MINIO_PASSWORD=
AGENTTEAMS_MINIO_BUCKET=

# ===== 2. 数据库 =====
# 每个数据库可声明为「外部已存在」(XXX_EXTERNAL=1)：此时跳过安装，直接使用下方连接信息。
# 未声明外部时，在本机用 docker compose 安装；首次随机生成强密码并持久化到
# ${RUNTIME_DIR}/db/.env（后续运行复用，绝不重复生成）。

## PostgreSQL + pgvector
POSTGRES_EXTERNAL=0
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agentteams
POSTGRES_USER=agent
POSTGRES_PASSWORD=

## Redis
REDIS_EXTERNAL=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

## Meilisearch
MEILI_EXTERNAL=0
MEILI_HOST=127.0.0.1
MEILI_PORT=7700
MEILI_MASTER_KEY=

## Neo4j（知识图谱）
NEO4J_EXTERNAL=0
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# 本机访问端口速查（内部库默认绑定 127.0.0.1）：
#   PostgreSQL   : 127.0.0.1:5432  (db=${POSTGRES_DB}, user=${POSTGRES_USER})
#   Redis        : 127.0.0.1:6379
#   Meilisearch  : 127.0.0.1:7700
#   Neo4j (Bolt) : 127.0.0.1:7687  (user=${NEO4J_USER})
#   Neo4j (HTTP) : 127.0.0.1:7474  (浏览器查看)

# ===== 3. 领域技能 MCP Server =====
# 始终运行在本机（绑定 MCP_HOST，监听 MCP_PORT）。
# worker YAML 与技能包 manifest 中的 MCP 端点采用 __MCP_WORKER_HOST__:__MCP_PORT__
# 占位符，部署/打包时由脚本按本段配置渲染替换——改端口只需改 MCP_PORT。
MCP_HOST=0.0.0.0
MCP_PORT=8090
# Worker 容器内访问 MCP 所用的主机名：
# - macOS/Windows Docker Desktop：host.docker.internal 内置解析，保持默认。
# - Linux（含 Alibaba Cloud Linux）：容器内不自动解析该名；部署脚本在 docker 就绪后
#   自动探测 Docker 网桥网关 IP 并回退为该网关，保持默认无需手动处理。
MCP_WORKER_HOST=host.docker.internal

# Embedding（语义向量路，OpenAI 兼容后端）：
#   - 默认用硅基流动 SiliconFlow .cn（国内直连）；.cn 与 .com 账户体系不互通，
#     OPENAI_API_KEY 必须来自对应站点。
#   - EMBED_DIM 必须与模型维度一致：BAAI/bge-m3 = 1024。
EMBED_BACKEND=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
# MCP 层 OpenTelemetry Span 上报开关
MCP_OTEL_ENABLED=false

# ===== 4. AgentLoop 可观测（可选） =====
# AGENTLOOP_ENABLED=1 时才接入；凭证在阿里云 AgentLoop 控制台「接入中心 > OpenClaw」复制。
# 安装时会被映射为安装器的 AGENTTEAMS_CMS_* 配置并注入 controller。
AGENTLOOP_ENABLED=0
AGENTLOOP_ENDPOINT=
AGENTLOOP_LICENSE_KEY=
AGENTLOOP_PROJECT=
AGENTLOOP_WORKSPACE=
AGENTLOOP_SERVICE_NAME=
