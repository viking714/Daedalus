# 云端数据库栈连接配置 (部署在阿里云 ECS 8.130.191.237)
# 用法: cp .env.db.example .env.db 后修改密码, 再随 docker-compose.db.yml 部署
# 注意: .env.db 已被 .gitignore 忽略, 不会提交

# ---- PostgreSQL + pgvector ----
POSTGRES_DB=agentteams
POSTGRES_USER=agent
POSTGRES_PASSWORD=请改成强密码

# ---- Redis ----
REDIS_PASSWORD=

# ---- Meilisearch (全文检索, master key 至少 8 位) ----
MEILI_ENV=development
MEILI_MASTER_KEY=请改成至少16位强密钥

# ---- Neo4j (图数据库) ----
NEO4J_PASSWORD=请改成强密码

# ============================================================
# 本地访问: 先跑 ./scripts/ecs-tunnel.sh 建立 SSH 隧道, 之后连接地址均为 127.0.0.1
#   PostgreSQL   : 127.0.0.1:5432  (db=agentteams, user=agent)
#   Redis        : 127.0.0.1:6379
#   Meilisearch  : 127.0.0.1:7700
#   Neo4j (Bolt) : 127.0.0.1:7687  (user=neo4j)
#   Neo4j (HTTP) : 127.0.0.1:7474  (浏览器打开查看)
# ============================================================

# ============================================================
# Embedding（语义向量路，OpenAI 兼容后端）
# 默认用硅基流动 SiliconFlow .cn（国内直连、OpenAI 兼容），避免 HuggingFace xet 下载
# 注意：.cn 与 .com 账户体系不互通，key 必须来自对应站点
# EMBED_DIM 必须与模型维度一致：BAAI/bge-m3 = 1024
# ============================================================
EMBED_BACKEND=openai
OPENAI_API_KEY=替换为你的硅基流动密钥
OPENAI_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
