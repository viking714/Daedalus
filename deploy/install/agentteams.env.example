# HiClaw Embedded 安装环境变量样例
# 复制为 agentteams.env 后填写；官方安装器读取 HICLAW_* 前缀变量
# 默认使用硅基流动 SiliconFlow 国内版（.cn，国内直连、OpenAI 兼容）
# 注意：.cn 与 .com 账户体系不互通，key 必须来自对应站点

HICLAW_NON_INTERACTIVE=0
HICLAW_LLM_PROVIDER=openai-compat
# 默认模型（fallback），各 Worker 在 YAML 中通过 model: 字段覆盖（见补充设计文档 §8.2）：
#   Manager / Analyzer → deepseek-ai/DeepSeek-V4-Pro（RPM 500 / TPM 2M，长上下文）
#   Fixer / Tester      → moonshotai/Kimi-K2.7-Code（RPM 500 / TPM 2M，代码专用）
#   Evaluator           → Pro/deepseek-ai/DeepSeek-V3.2（RPM 500 / TPM 2M，思维链质量门禁）
HICLAW_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Pro
HICLAW_LLM_API_KEY=replace-with-your-key
HICLAW_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
HICLAW_ADMIN_USER=admin
HICLAW_ADMIN_PASSWORD=replace-with-a-strong-password
HICLAW_PORT_GATEWAY=18080
HICLAW_PORT_CONSOLE=18001
HICLAW_PORT_ELEMENT_WEB=18088
HICLAW_MATRIX_DOMAIN=matrix-local.hiclaw.io:18080
HICLAW_DATA_DIR=hiclaw-data
HICLAW_WORKSPACE_DIR=$HOME/hiclaw-manager
HICLAW_VERSION=latest
HICLAW_REGISTRY=

# MinIO 共享存储（Worker 间文件交换：仓库代码、分析报告、diff、测试报告）
# AgentTeams 平台内置 MinIO，Worker 通过 mc CLI 访问
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-with-your-access-key
MINIO_SECRET_KEY=replace-with-your-secret-key
MINIO_BUCKET=shared-tasks

# 备选：DeepSeek 官方（免费 $5 + 每天 50 次，国内直连）
# HICLAW_LLM_API_KEY=sk-xxx
# HICLAW_OPENAI_BASE_URL=https://api.deepseek.com/v1
# HICLAW_DEFAULT_MODEL=deepseek-ai/DeepSeek-V4-Pro

# ---------------------------------------------------------------------------
# AgentLoop / OpenTelemetry 可观测配置（可选）
# 在 AgentLoop 控制台「接入中心 > OpenClaw」页面复制对应值填入
# ---------------------------------------------------------------------------
# AGENTLOOP_ENDPOINT=https://proj-xtrace-xxx.cn-hangzhou.log.aliyuncs.com/apm/trace/opentelemetry
# AGENTLOOP_LICENSE_KEY=xxx
# AGENTLOOP_PROJECT=proj-xtrace-xxx-cn-hangzhou
# AGENTLOOP_WORKSPACE=agentloop-xxx
# AGENTLOOP_SERVICE_NAME=daedalus-agent-teams

# MCP Server 层 OTel 开关（true 时启用 MCP 原语/组合工具 Span 上报）
# MCP_OTEL_ENABLED=true
