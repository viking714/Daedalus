      "code-read",
      "bash-exec",
      "test-run",
      "patch-generate",
      "result-judge",
      "multi-file-edit"
    ],
    "with_scripts": [
      "repo-index",
      "code-search",
      "impact-analysis",
      "root-cause-analysis",
      "repair-planning",
      "pipeline-router",
      "module-lookup",
      "lesson-lookup",
      "knowledge-extraction",
      "prd-authoring",
      "architecture-design",
      "ops-diagnosis",
      "env-inventory",
      "visual-check",
      "test-plan"
    ]
  },
  "workers": {
    "team_leader":  ["repo-index", "pipeline-router", "code-read", "bash-exec"],
    "coordinator":  ["repo-index", "pipeline-router", "code-read", "bash-exec"],
    "po":           ["prd-authoring", "code-read", "lesson-lookup"],
    "architect":    ["architecture-design", "code-read", "bash-exec", "code-search", "impact-analysis", "root-cause-analysis", "module-lookup", "lesson-lookup", "visual-check"],
    "developer":    ["code-read", "bash-exec", "patch-generate", "multi-file-edit", "repair-planning", "lesson-lookup", "visual-check"],
    "tester":       ["bash-exec", "test-run", "result-judge", "test-plan", "visual-check"],
    "reviewer":     ["code-read", "bash-exec", "impact-analysis", "result-judge", "knowledge-extraction", "visual-check"],
